# UI application base URL
BASE_URL=https://example.com

# API base URL
API_BASE_URL=https://jsonplaceholder.typicode.com

# Optional auth
API_TOKEN=
API_KEY=

# API health check path (relative to API_BASE_URL)
API_HEALTH_PATH=/posts/1

# UI auth setup (optional — enables storageState reuse)
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_LOGIN_PATH=/login

# Runtime
HEADLESS=true
DEBUG=
